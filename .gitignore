# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# pm2 logs
/logs

# user uploaded files — don't commit to version control
/public/uploads

# ── Build and debug logs ────────────────────────────────────────────────────────
*.log
*.log.*
build_*.txt
build_*.log
compile.log
debug-output.txt
lint-report*.json
lint_output*.txt
lint_results*.txt
test-firebase-output.txt

# ── Sensitive / private files ── NEVER commit these ────────────────────────────
private-key-raw.txt
extract-key.js
test-env.js

# ── Legacy SQL / migration files ────────────────────────────────────────────────
*.sql

# ── Old docs and backup files ───────────────────────────────────────────────────
*.bak
APPWRITE_SETUP.md
CRITICAL_FIXES.md
DEBUG_REPORT.md
DEBUG_SUMMARY.md
FIREBASE_MIGRATION.md
FIREBASE_SETUP.md
FIXES_APPLIED.md
MIGRATION_COMPLETE.md
PROJECT_ANALYSIS.md
REGISTRATION_FIX.md
SHARE_MEETING_DOCS.md

